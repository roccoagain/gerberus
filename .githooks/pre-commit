#!/bin/sh
# Runs the quick CI checks before each commit. Turn it on once per clone with:
#   git config core.hooksPath .githooks
# Skip it for one commit with `git commit --no-verify`.
set -e

cargo fmt --all --check || {
    echo "pre-commit: run 'cargo fmt --all' and stage the result" >&2
    exit 1
}
cargo clippy --all-targets --locked --quiet -- -D warnings
